# FinanceOS environment configuration.
# Copy this file to `.env` and adjust values as needed. Used by docker-compose
# and (optionally) by the Python server when it auto-loads .env on startup.

# Host port the dashboard is published on. Container port is fixed to 8080.
FINANCEOS_PORT=8080

# Optional: override the auto-detected host type. Leave empty for auto-detect.
# Set to "pi" on a Raspberry Pi to enable Pi-specific paths and behaviors.
FINANCEOS_HOST_TYPE=

# Optional: Anthropic API key for any features that talk to Claude.
# The dashboard works fully without this — only set if you want LLM-backed
# features enabled.
# ANTHROPIC_API_KEY=
