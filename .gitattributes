# Normalize line endings: LF in repo, native on checkout
* text=auto

# Force LF for these (consistent across OS)
*.md text eol=lf
*.csv text eol=lf
*.py text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
# Shell scripts + crontab templates + systemd units run on Linux hosts —
# a CRLF here breaks bash ("$'do\r'") and cron lines outright. Editing on
# the Windows dev box must never leak \r into them (bitten 2026-06-12).
*.sh text eol=lf
*.crontab text eol=lf
*.service text eol=lf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.xls binary
*.mmb binary
