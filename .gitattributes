# Normalize line endings: LF in repo, native on checkout
* text=auto

# Force LF for these (consistent across OS)
*.md text eol=lf
*.csv text eol=lf
*.py text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.xls binary
*.mmb binary
